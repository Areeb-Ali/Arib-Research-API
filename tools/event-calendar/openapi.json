          }
        ]
      }
    },
    "/methodology": {
      "get": {
        "summary": "Importance rules and categories (versioned)",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          },
          "401": {
            "description": "Missing or invalid key"
          },
          "403": {
            "description": "Key expired or revoked"
          },
          "429": {
            "description": "Limit reached; see Retry-After and X-RateLimit-* headers"
          }
        },
        "security": [
          {
            "ApiKey": []
          }
        ]
      }
    }
  }
}
