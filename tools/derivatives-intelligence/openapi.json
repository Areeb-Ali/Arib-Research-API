{
  "openapi": "3.0.3",
  "info": {
    "title": "Derivatives Intelligence Data API",
    "version": "v1",
    "description": "Free beta. Research only, not financial advice."
  },
  "servers": [
    {
      "url": "https://api-derivatives.areebalikhan.com/v1"
    }
  ],
  "components": {
    "securitySchemes": {
      "apiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      }
    }
  },
  "security": [
    {
      "apiKey": []
    }
  ],
  "paths": {
    "/status": {
      "get": {
        "summary": "Service status and your plan",
        "parameters": [],
        "responses": {
          "200": {
            "description": "{ data, meta } with attribution, license and notice in meta"
          },
          "401": {
            "description": "missing, wrong or revoked key"
          },
          "403": {
            "description": "outside your plan"
          },
          "429": {
            "description": "rate limit, quota or global limit, see Retry-After"
          }
        }
      }
    },
    "/markets": {
      "get": {
        "summary": "Headline numbers for BTC, ETH and SOL",
        "parameters": [],
