{
  "openapi": "3.0.3",
  "info": {
    "title": "Macro Intelligence public API",
    "version": "v1",
    "description": "Research only, not financial advice. Personal and internal use. No resale, redistribution or republication of the data."
  },
  "servers": [
    {
      "url": "https://macro.aribresearch.com"
    }
  ],
  "components": {
    "securitySchemes": {
      "apiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      }
    },
    "schemas": {
      "Envelope": {
        "type": "object",
        "required": [
          "api_version",
          "methodology_version",
          "generated_at",
          "attribution",
          "license",
          "notice",
          "data"
        ],
        "properties": {
          "api_version": {
            "type": "string"
          },
          "methodology_version": {
            "type": "string"
          },
          "generated_at": {
            "type": "string",
            "format": "date-time"
          },
          "attribution": {
            "type": "string"
          },
          "license": {
            "type": "string"
          },
          "notice": {
            "type": "string"
          },
          "data": {
            "type": "object"
          }
        }
      }
    }
  },
  "paths": {
    "/v1/snapshot": {
      "get": {
        "summary": "Current macro regime, Macro Score (0-100), coverage, agreement, drivers, key changes",
        "security": [
          {
            "apiKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "headers": {
              "X-RateLimit-Minute-Limit": {
                "schema": {
                  "type": "integer"
                }
              },
              "X-RateLimit-Minute-Remaining": {
                "schema": {
                  "type": "integer"
                }
              },
              "X-RateLimit-Limit": {
                "schema": {
                  "type": "integer"
                }
              },
              "X-RateLimit-Remaining": {
                "schema": {
                  "type": "integer"
                }
              },
              "X-RateLimit-Daily-Limit": {
                "schema": {
                  "type": "integer"
                }
              },
              "X-RateLimit-Daily-Remaining": {
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid key"
          },
          "403": {
            "description": "Plan without API access"
          },
          "429": {
            "description": "Rate limit or quota reached; see Retry-After",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                }
              }
            }
          }
        }
      }
    },
