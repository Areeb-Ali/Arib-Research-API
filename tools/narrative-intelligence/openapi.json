          },
          {}
        ],
        "responses": {
          "200": {
            "description": "JSON with attribution, license and notice"
          },
          "401": {
            "description": "Invalid, expired or revoked key"
          },
          "429": {
            "description": "Rate limit reached; see Retry-After"
          }
        }
